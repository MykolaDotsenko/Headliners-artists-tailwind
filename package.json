{
  "name": "headliners-festival-experience",
  "version": "2.0.0",
  "private": true,
  "description": "Accessible, responsive festival campaign experience built with semantic HTML, Tailwind CSS, and progressive vanilla JavaScript.",
  "scripts": {
    "dev:css": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "build:verify": "tailwindcss -i ./src/input.css -o /tmp/headliners-output.css --minify",
    "assets:build": "node scripts/build-images.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.mjs --project=chromium",
    "lighthouse": "lhci autorun --config=./lighthouserc.json",
    "quality": "node scripts/quality.mjs",
    "check": "npm run test && npm run quality && npm run build:verify",
    "check:full": "npm run assets:build && npm run check && npm run test:browser && npm run lighthouse"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.4"
  }
}
